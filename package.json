import time
import json
import os
import smtplib
from datetime import datetime
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart

# Configurações de E-mail
EMAIL_DESTINO = "Ronnydias3134@gmail.com"
EMAIL_REMETENTE = os.environ.get("EMAIL_REMETENTE", "teu_email@gmail.com")
SENHA_EMAIL = os.environ.get("SENHA_EMAIL", "tua_senha_app")

# Ficheiro de Estado para Juros Compostos
ARQUIVO_ESTADO = "circuito_global_producao.json"

def carregar_estado():
    if os.path.exists(ARQUIVO_ESTADO):
        with open(ARQUIVO_ESTADO, "r") as f:
            return json.load(f)
    return {
        "banca_atual": 2000.0, 
        "primeiro_negocio_realizado": False, 
        "historico_lucros": 0.0,
        "lucro_acumulado_hoje": 0.0,
        "transacoes_hoje": 0
    }

def guardar_estado(estado):
    with open(ARQUIVO_ESTADO, "w") as f:
        json.dump(estado, f)

def enviar_email(assunto, corpo):
    try:
        msg = MIMEMultipart()
        msg['From'] = EMAIL_REMETENTE
        msg['To'] = EMAIL_DESTINO
        msg['Subject'] = assunto
        msg.attach(MIMEText(corpo, 'plain'))

        server = smtplib.SMTP('smtp.gmail.com', 587)
        server.starttls()
        server.login(EMAIL_REMETENTE, SENHA_EMAIL)
        server.sendmail(EMAIL_REMETENTE, EMAIL_DESTINO, msg.as_string())
        server.quit()
    except Exception as e:
        print(f"Erro ao enviar e-mail: {e}")

def motor_circuito_global():
    estado = carregar_estado()
    ultima_notificacao_horaria = time.time()
    ultimo_dia_relatorio = datetime.now().day
    
    print("Circuito Global iniciado em produção...")

    while True:
        tempo_atual = time.time()
        data_atual = datetime.now()
        
        # 1. ANTES DO 1º NEGÓCIO: Envia relatórios de hora em hora
        if not estado["primeiro_negocio_realizado"]:
            if tempo_atual - ultima_notificacao_horaria >= 3600: # 3600 segundos = 1 hora
                assunto = "Circuito Global: Relatório de Monitorização Horária"
                corpo = (
                    f"Olá Ronilson,\n\n"
                    f"O sistema continua ativo a varrer o mercado em busca da melhor oportunidade de arbitragem.\n"
                    f"Banca atual em teste: {estado['banca_atual']} CVE.\n"
                    f"Estado atual: À procura do primeiro negócio real.\n\n"
                    f"Assim que a primeira transação for concluída com sucesso, receberás um alerta imediato."
                )
                enviar_email(assunto, corpo)
                ultima_notificacao_horaria = time.time()

        # 2. APÓS O 1º NEGÓCIO: Envia relatório diário no fim do dia (ex: às 23:59 ou mudança de dia)
        else:
            if data_atual.day != ultimo_dia_relatorio:
                assunto_diario = f"Circuito Global: Relatório Diário de Fecho ({data_atual.strftime('%d/%m/%Y')})"
                corpo_diario = (
                    f"Olá Ronilson,\n\n"
                    f"Aqui está o resumo do desempenho do Circuito Global hoje:\n\n"
                    f"- Transações efetuadas hoje: {estado['transacoes_hoje']}\n"
                    f"- Lucro gerado hoje: {estado['lucro_acumulado_hoje']} CVE\n"
                    f"- Nova banca total reinvestida: {estado['banca_atual']} CVE\n\n"
                    f"O sistema continua a operar com juros compostos ativos."
                )
                enviar_email(assunto_diario, corpo_diario)
                
                # Reseta contadores diários para o novo dia
                estado['lucro_acumulado_hoje'] = 0.0
                estado['transacoes_hoje'] = 0
                ultimo_dia_relatorio = data_atual.day
                guardar_estado(estado)

        # Simulação da varredura de mercado pelos AMAs
        oportunidade_encontrada = False # Altere para True quando fechar negócio
        
        if oportunidade_encontrada:
            lucro_operacao = 150.0 # Exemplo de lucro em CVE
            
            # Atualização com Juros Compostos
            estado["banca_atual"] += lucro_operacao 
            estado["historico_lucros"] += lucro_operacao
            estado["lucro_acumulado_hoje"] += lucro_operacao
            estado["transacoes_hoje"] += 1
            
            foi_primeiro = not estado["primeiro_negocio_realizado"]
            estado["primeiro_negocio_realizado"] = True
            guardar_estado(estado)

            # Se for o primeiríssimo negócio da história do bot, envia alerta imediato de sucesso
            if foi_primeiro:
                assunto_sucesso = "Circuito Global: Primeiro Negócio Concluído com Sucesso!"
                corpo_sucesso = (
                    f"Parabéns Ronilson!\n\n"
                    f"O primeiro negócio foi executado com sucesso.\n"
                    f"Lucro obtido: {lucro_operacao} CVE.\n"
                    f"Nova banca total reinvestida: {estado['banca_atual']} CVE.\n\n"
                    f"A partir de agora, as notificações passam a ser enviadas diariamente no final de cada dia."
                )
                enviar_email(assunto_sucesso, corpo_sucesso)

        time.sleep(60) # Verifica o mercado a cada minuto

if __name__ == "__main__":
    motor_circuito_global()
